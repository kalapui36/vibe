PORT=3000
# First startup only: optionally override the default administrator password (4+ characters).
# Prefer: npm run admin:password (hidden terminal input).
# ADMIN_PASSWORD=
# For deployment behind an HTTPS reverse proxy:
# APP_ORIGIN=https://your-domain.example
# TRUST_PROXY=1
# COOKIE_SECURE=1
# CHROMIUM_PATH=/usr/bin/chromium
# DATA_DIR=/absolute/path/to/persistent/data

# GitHub OAuth administrator service (npm run start:auth)
# Set these only in the authentication server environment, never in public files.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# AUTH_SESSION_SECRET= (at least 32 random characters; Render generates this)
# AUTH_ORIGIN=https://your-admin-service.onrender.com
# PUBLIC_BASE_URL=https://kalapui.com/vibe/
# GITHUB_ALLOWED_USER=kalapui36
# Optional immutable GitHub numeric user ID:
# GITHUB_ALLOWED_USER_ID=
