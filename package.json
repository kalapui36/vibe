{
  "name": "vibe",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:pages": "node scripts/build-pages.js",
    "test:pages": "node --test test/pages.test.js test/github-pages-admin.test.js",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "admin:password": "node scripts/set-password.js",
    "test": "node --test test/*.test.js",
    "start:auth": "node --use-env-proxy --env-file-if-exists=.env auth-server.js",
    "test:oauth": "node --test test/oauth.test.js test/github-pages-admin.test.js"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "dependencies": {
    "express": "5.1.0",
    "playwright-core": "1.56.1"
  }
}
